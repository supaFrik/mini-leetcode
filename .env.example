# DEV ONLY. Copy to .env (setup-demo.ps1 does this when .env is missing).
# Never use these values on a shared or public server.

# First ADMIN account, created by the API on startup if the username does not exist yet.
# Leave BOOTSTRAP_ADMIN_USERNAME empty to skip it.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456

# Host port of the web app (default 3100).
# FRONTEND_PORT=3100
