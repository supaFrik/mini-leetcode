# Địa chỉ backend Spring Boot (Next.js proxy /api/* sang đây)
BACKEND_URL=http://localhost:8080

# true  = chạy bằng dữ liệu giả trong trình duyệt (không cần backend)
# false = gọi backend thật
NEXT_PUBLIC_USE_MOCK=true

# Chỉ bật khi backend đã có các endpoint tương ứng (xem README_FRONTEND.md)
NEXT_PUBLIC_ENABLE_RUN=false
NEXT_PUBLIC_ENABLE_DRAFT_SYNC=false
