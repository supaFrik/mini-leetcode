{
  "slug": "oop-7-interface",
  "title": "Bài 7 — Interface & tách lệnh (Command)",
  "difficulty": "MEDIUM",
  "tags": ["OOP", "Interface", "Design Pattern"],
  "forStage": 5,
  "rules": [
    {
      "ruleName": "COMMAND_IS_INTERFACE",
      "targetClassName": "Command",
      "expectedType": "INTERFACE",
      "methods": [
        {"name": "name", "returnType": "String"},
        {"name": "run", "returnType": "String", "parameterTypes": ["String"]}
      ],
      "customFailureMessage": "Command phải là interface có String name() và String run(String)"
    },
    {
      "ruleName": "ECHO_IMPLEMENTS_COMMAND",
      "targetClassName": "EchoCommand",
      "expectedType": "CLASS",
      "expectedInterfaces": ["Command"],
      "customFailureMessage": "EchoCommand phải implements Command"
    },
    {
      "ruleName": "ADD_IMPLEMENTS_COMMAND",
      "targetClassName": "AddCommand",
      "expectedType": "CLASS",
      "expectedInterfaces": ["Command"],
      "customFailureMessage": "AddCommand phải implements Command"
    },
    {
      "ruleName": "UPPER_IMPLEMENTS_COMMAND",
      "targetClassName": "UpperCommand",
      "expectedType": "CLASS",
      "expectedInterfaces": ["Command"],
      "customFailureMessage": "UpperCommand phải implements Command"
    }
  ],
  "cases": [
    {"name": "vi-du", "stdin": "HELP\nECHO xin   chào\nADD 1 2 3\nADD 4 x\nUPPER mini bank\nPING\n"},
    {"name": "add-rong-va-am", "stdin": "ADD\nADD -5 10\nADD 3000000000 3000000000\n"},
    {"name": "lenh-la", "stdin": "echo thường\nEXIT\nHELP\n"},
    {"name": "upper-tieng-viet", "stdin": "UPPER đồng việt nam\nECHO\n"}
  ]
}
