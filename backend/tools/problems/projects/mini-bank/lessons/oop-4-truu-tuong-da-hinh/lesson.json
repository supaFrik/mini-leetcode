{
  "slug": "oop-4-truu-tuong-da-hinh",
  "title": "Abstract classes and polymorphism: shapes",
  "difficulty": "EASY",
  "tags": ["OOP", "Abstraction", "Polymorphism"],
  "forStage": 2,
  "rules": [
    {
      "ruleName": "SHAPE_IS_ABSTRACT",
      "targetClassName": "Shape",
      "expectedType": "ABSTRACT_CLASS",
      "methods": [
        {"name": "area", "returnType": "double", "requiredModifiers": ["public", "abstract"]},
        {"name": "name", "returnType": "String", "requiredModifiers": ["public", "abstract"]},
        {"name": "describe", "returnType": "String", "requiredModifiers": ["public"], "forbiddenModifiers": ["abstract"]}
      ],
      "customFailureMessage": "Shape must be abstract with public abstract double area(), public abstract String name() and public String describe()"
    },
    {
      "ruleName": "CIRCLE_EXTENDS_SHAPE",
      "targetClassName": "Circle",
      "expectedType": "CLASS",
      "expectedSuperclass": "Shape",
      "methods": [{"name": "area", "returnType": "double", "forbiddenModifiers": ["abstract"]}],
      "customFailureMessage": "Circle must extend Shape and implement area()"
    },
    {
      "ruleName": "RECTANGLE_EXTENDS_SHAPE",
      "targetClassName": "Rectangle",
      "expectedType": "CLASS",
      "expectedSuperclass": "Shape",
      "methods": [{"name": "area", "returnType": "double", "forbiddenModifiers": ["abstract"]}],
      "customFailureMessage": "Rectangle must extend Shape and implement area()"
    },
    {
      "ruleName": "SQUARE_EXTENDS_RECTANGLE",
      "targetClassName": "Square",
      "expectedType": "CLASS",
      "expectedSuperclass": "Rectangle",
      "customFailureMessage": "Square must extend Rectangle"
    }
  ],
  "cases": [
    {"name": "example", "stdin": "CIRCLE 1\nRECT 2 3\nSQUARE 2.5\n"},
    {"name": "tie-keeps-first", "stdin": "RECT 2 2\nSQUARE 2\nCIRCLE 0.5\n"},
    {"name": "zero-area", "stdin": "CIRCLE 0\nRECT 0 5\n"},
    {"name": "no-shapes", "stdin": "\n"},
    {"name": "large-values", "stdin": "CIRCLE 1000\nRECT 1000 1000\nSQUARE 1500\nCIRCLE 10.5\n"}
  ]
}
