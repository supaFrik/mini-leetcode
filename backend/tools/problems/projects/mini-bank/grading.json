{
  "_comment": "Rule OOP theo stage: stage N dùng mọi rule có fromStage <= N (cộng dồn). Trường fromStage bị bỏ khi ghi vào problems.grading_config. 'output' áp dụng cho mọi stage: normalized = bỏ khoảng trắng / dòng trống thừa, không bắt căn cột đúng từng dấu cách.",
  "output": {"mode": "normalized", "ignoreCase": false},
  "rules": [
    {
      "fromStage": 1,
      "ruleName": "ACCOUNT_ENCAPSULATED",
      "targetClassName": "Account",
      "weight": 1.0,
      "fields": [{"name": "*", "matchAllFields": true, "forbiddenModifiers": ["public"]}],
      "methods": [
        {"name": "deposit", "returnType": "long", "parameterTypes": ["long"], "requiredModifiers": ["public"]},
        {"name": "getBalance", "returnType": "long", "requiredModifiers": ["public"]}
      ],
      "customFailureMessage": "Account không được có field public và phải có public long deposit(long), public long getBalance()"
    },
    {
      "fromStage": 2,
      "ruleName": "ACCOUNT_IS_ABSTRACT_BASE",
      "targetClassName": "Account",
      "expectedType": "ABSTRACT_CLASS",
      "weight": 2.0,
      "methods": [
        {"name": "canWithdraw", "returnType": "boolean", "parameterTypes": ["long"], "requiredModifiers": ["abstract"]},
        {"name": "endOfMonth", "returnType": "void", "requiredModifiers": ["abstract"]},
        {"name": "getType", "returnType": "String", "requiredModifiers": ["abstract"]},
        {"name": "withdraw", "returnType": "long", "parameterTypes": ["long"], "requiredModifiers": ["public"]}
      ],
      "customFailureMessage": "Account phải là lớp abstract với các phương thức abstract canWithdraw(long), endOfMonth(), getType() và public long withdraw(long)"
    },
    {
      "fromStage": 2,
      "ruleName": "SAVINGS_EXTENDS_ACCOUNT",
      "targetClassName": "SavingsAccount",
      "expectedType": "CLASS",
      "expectedSuperclass": "Account",
      "methods": [
        {"name": "canWithdraw", "returnType": "boolean", "parameterTypes": ["long"], "forbiddenModifiers": ["abstract"]},
        {"name": "endOfMonth", "returnType": "void", "forbiddenModifiers": ["abstract"]}
      ],
      "customFailureMessage": "SavingsAccount phải kế thừa Account và cài đặt canWithdraw(long), endOfMonth()"
    },
    {
      "fromStage": 2,
      "ruleName": "CHECKING_EXTENDS_ACCOUNT",
      "targetClassName": "CheckingAccount",
      "expectedType": "CLASS",
      "expectedSuperclass": "Account",
      "methods": [
        {"name": "canWithdraw", "returnType": "boolean", "parameterTypes": ["long"], "forbiddenModifiers": ["abstract"]},
        {"name": "endOfMonth", "returnType": "void", "forbiddenModifiers": ["abstract"]}
      ],
      "customFailureMessage": "CheckingAccount phải kế thừa Account và cài đặt canWithdraw(long), endOfMonth()"
    },
    {
      "fromStage": 3,
      "ruleName": "CHECKED_INSUFFICIENT_FUNDS",
      "targetClassName": "InsufficientFundsException",
      "expectedType": "CLASS",
      "expectedSuperclass": "Exception",
      "customFailureMessage": "InsufficientFundsException phải là checked exception (extends Exception)"
    },
    {
      "fromStage": 4,
      "ruleName": "BANK_ENCAPSULATION",
      "targetClassName": "Bank",
      "expectedType": "CLASS",
      "enforceEncapsulation": true,
      "methods": [
        {"name": "open", "returnType": "Account", "parameterTypes": ["String", "String", "long"], "requiredModifiers": ["public"]},
        {"name": "find", "returnType": "Account", "parameterTypes": ["int"], "requiredModifiers": ["public"]},
        {"name": "transfer", "returnType": "void", "parameterTypes": ["int", "int", "long"], "requiredModifiers": ["public"]}
      ],
      "customFailureMessage": "Bank phải đóng gói danh sách tài khoản (field private) và có public open(String, String, long), find(int), transfer(int, int, long)"
    }
  ]
}
